<odoo>
    <data>
        <template id="custom_register_template" name="Custom Register Page">
            <html>
                <head>
                    <title>Registrasi - Prosi Kedokteran</title>
                    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"/>
                    <link rel="stylesheet" href="/prosi_kedokteran/static/src/css/register.css"/>
                </head>
                <body>
                    <div class="container">
                        <div class="card login-box shadow p-4" style="max-width: 450px; margin: 80px auto;">
                            <h3 class="text-center mb-4">Pendaftaran Akun</h3>
                            
                            <form action="/kedokteran/register/submit" method="post">
                                <div class="mb-3">
                                    <label class="form-label">Nama Lengkap</label>
                                    <input type="text" name="name" class="form-control" required="required"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Email / Username Baru</label>
                                    <input type="text" name="login" class="form-control" required="required"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Password</label>
                                    <input type="password" name="password" class="form-control" required="required"/>
                                </div>
                                <button type="submit" class="btn btn-success w-100">Daftar Sekarang</button>
                                
                                <div class="text-center mt-3">
                                    <a href="/kedokteran/login" class="text-decoration-none">Sudah punya akun? Login di sini</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </body>
            </html>
        </template>
    </data>
</odoo>