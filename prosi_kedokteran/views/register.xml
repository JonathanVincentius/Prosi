<odoo>
    <data>
        <template id="custom_register_template" name="Custom Register Page">
            <html>
                <head>
                    <title>Daftar Akun Baru - BandaSehat</title>
                    <meta name="viewport" content="width=device-width, initial-scale=1"/>
                    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"/>
                    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
                    <link rel="stylesheet" href="/prosi_kedokteran/static/src/css/register.css"/>
                </head>
                <body>
                    <div class="register-header">
                        <div class="container-fluid px-4">
                            <a href="/kedokteran" class="back-link">
                                <i class="fa-solid fa-arrow-left"></i>
                            </a>
                            <h2 class="fw-bold mt-2">Daftar Akun Baru</h2>
                            <p class="mb-0">Bergabung bersama 50.000+ Bunda!</p>
                        </div>
                    </div>

                    <div class="container-fluid px-4 py-4">
                        <form action="/kedokteran/register/submit" method="post">
                            
                            <div class="mb-4">
                                <label class="form-label-custom">Nama Lengkap</label>
                                <input type="text" name="name" class="form-control-custom" placeholder="Siti Rahayu" required="required"/>
                            </div>

                            <div class="mb-4">
                                <label class="form-label-custom">Username</label>
                                <input type="text" name="login" class="form-control-custom" placeholder="sitirahayu" required="required"/>
                            </div>

                            <div class="mb-4">
                                <label class="form-label-custom">Password</label>
                                <input type="password" name="password" class="form-control-custom" placeholder="••••••••••••" required="required"/>
                            </div>

                            <div class="mb-4">
                                <label class="form-label-custom">Tanggal Lahir</label>
                                <div class="row g-2">
                                    <div class="col-4">
                                        <input type="number" name="birth_date" class="form-control-custom text-center" placeholder="24"/>
                                    </div>
                                    <div class="col-4">
                                        <input type="number" name="birth_month" class="form-control-custom text-center" placeholder="05"/>
                                    </div>
                                    <div class="col-4">
                                        <input type="number" name="birth_year" class="form-control-custom text-center" placeholder="1995"/>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label-custom">No. Telpon</label>
                                <input type="text" name="phone" class="form-control-custom" placeholder="08123456789"/>
                            </div>

                            <div class="mb-4">
                                <label class="form-label-custom">Alamat Tempat Tinggal</label>
                                <textarea name="address" class="form-control-custom" rows="3" placeholder="Jl. Mawar No 1, Jakarta"></textarea>
                            </div>

                            <div class="mb-4">
                                <label class="form-label-custom d-block mb-2">Riwayat Obstetri</label>
                                <div class="d-flex gap-2 mb-3">
                                    <span class="badge-obstetri active">Kehamilan</span>
                                    <span class="badge-obstetri">Melahirkan</span>
                                    <span class="badge-obstetri">Keguguran</span>
                                </div>
                                <input type="number" name="count_pregnancy" class="form-control-custom mb-2" placeholder="Jml Kehamilan"/>
                                <input type="number" name="count_birth" class="form-control-custom mb-2" placeholder="Jml Melahirkan"/>
                                <input type="number" name="count_miscarriage" class="form-control-custom" placeholder="Jml Keguguran"/>
                            </div>

                            <div class="mb-5">
                                <label class="form-label-custom d-block mb-3">Anda sedang dalam fase apa?</label>
                                <div class="row g-2">
                                    <div class="col-4">
                                        <label class="fase-card-label w-100">
                                            <input type="radio" name="fase" value="pra" class="fase-radio-hidden"/>
                                            <div class="fase-card text-center">
                                                <div class="fase-icon">💖👨‍👩‍👦</div>
                                                <div class="fase-text">Pra-Kehamilan</div>
                                            </div>
                                        </label>
                                    </div>
                                    <div class="col-4">
                                        <label class="fase-card-label w-100">
                                            <input type="radio" name="fase" value="hamil" class="fase-radio-hidden" checked="checked"/>
                                            <div class="fase-card text-center">
                                                <div class="fase-icon">🤰</div>
                                                <div class="fase-text">Sedang Hamil</div>
                                            </div>
                                        </label>
                                    </div>
                                    <div class="col-4">
                                        <label class="fase-card-label w-100">
                                            <input type="radio" name="fase" value="bayi" class="fase-radio-hidden"/>
                                            <div class="fase-card text-center">
                                                <div class="fase-icon">👩‍🍼</div>
                                                <div class="fase-text">Punya Bayi</div>
                                            </div>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <button type="submit" class="btn-submit-custom">
                                    Daftar Sekarang <i class="fa-solid fa-arrow-right ms-1"></i>
                                </button>
                            </div>

                        </form>
                    </div>
                </body>
            </html>
        </template>
    </data>
</odoo>